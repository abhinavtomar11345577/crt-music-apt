#!/usr/bin/env python3
"""FSpotify: search and stream YouTube audio inside a CRT-shader terminal.

Runs on Linux, macOS and Windows. Everything outside the Python standard
library is optional at import time: the player needs mpv to play audio and
yt-dlp to search YouTube, and says so instead of failing if one is missing.
"""
import os
# Must be set before curses starts the terminal: see crt-pong/crt-snake for why.
os.environ.setdefault("ESCDELAY", "10")

import itertools
import json
import locale
import platform
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request

# Windows has no curses in its standard library; the windows-curses package
# supplies it. Import softly so --check and --version can explain what is
# missing rather than dying with a traceback.
try:
    import curses
except ImportError:  # pragma: no cover - depends on the platform
    curses = None

VERSION = "1.1.0"
IS_WINDOWS = os.name == "nt"
IS_MACOS = sys.platform == "darwin"


def app_bin_dir():
    """Private bin directory the installers use when no package manager can
    provide mpv or yt-dlp."""
    if IS_WINDOWS:
        base = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~")
        return os.path.join(base, "crt-music", "bin")
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "crt-music", "bin")


def _extend_path():
    """Make mpv and yt-dlp findable when the app is started from an icon.

    A desktop entry, Dock icon or Start-menu shortcut runs with a minimal
    PATH: on macOS that misses Homebrew entirely, on Windows it misses the
    scoop/choco/winget shim directories, and everywhere it misses the private
    directory above.
    """
    extra = [app_bin_dir()]
    if not IS_WINDOWS:
        # Also the default location, in case XDG_DATA_HOME was set after the
        # installer put a helper in the standard one.
        extra.append(os.path.join(os.path.expanduser("~"), ".local", "share",
                                  "crt-music", "bin"))
    if IS_WINDOWS:
        local = os.environ.get("LOCALAPPDATA", "")
        progdata = os.environ.get("ProgramData", "")
        home = os.path.expanduser("~")
        extra += [
            os.path.join(local, "Microsoft", "WinGet", "Links"),
            os.path.join(home, "scoop", "shims"),
            os.path.join(progdata, "chocolatey", "bin"),
        ]
    else:
        extra += [
            "/opt/homebrew/bin",
            "/usr/local/bin",
            "/opt/local/bin",
            os.path.join(os.path.expanduser("~"), ".local", "bin"),
        ]
    path = os.environ.get("PATH", "").split(os.pathsep)
    # Reversed, so that the first entry of `extra` ends up first on PATH:
    # a fresh yt-dlp in the private directory must win over the distribution's,
    # which is usually years old and no longer works with YouTube.
    for directory in reversed(extra):
        if directory and directory not in path and os.path.isdir(directory):
            path.insert(0, directory)
    os.environ["PATH"] = os.pathsep.join(p for p in path if p)


_extend_path()


def _child_kwargs():
    """Keep helper programs from flashing a console window on Windows."""
    if IS_WINDOWS:
        return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0)}
    return {}


def tool_path(name):
    """Absolute path to mpv/yt-dlp, or None. shutil.which handles .exe for us."""
    return shutil.which(name)


# YouTube changes how it serves streams every few months and only a current
# yt-dlp keeps up: an older one still searches (search needs no stream
# extraction) but cannot play anything. Anything older than this is reported
# as the cause rather than left to look like a broken player. Bump it when
# cutting a release.
MIN_YTDLP = 20260101
YTDLP_RELEASE = "https://github.com/yt-dlp/yt-dlp/releases/latest/download"


def ytdlp_asset():
    """Name of the standalone yt-dlp build for this machine."""
    machine = (platform.machine() or "").lower()
    if IS_WINDOWS:
        return "yt-dlp.exe"
    if IS_MACOS:
        return "yt-dlp_macos"
    if machine in ("x86_64", "amd64"):
        return "yt-dlp_linux"
    if machine in ("aarch64", "arm64"):
        return "yt-dlp_linux_aarch64"
    if machine.startswith("armv7"):
        return "yt-dlp_linux_armv7l"
    return "yt-dlp"  # the portable zipapp: slower to start, runs on python3


def ytdlp_version():
    """(YYYYMMDD as an int, raw string) for the yt-dlp in use, or (None, None)."""
    found = tool_path("yt-dlp")
    if not found:
        return None, None
    try:
        out = subprocess.run(
            [found, "--version"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=20,
            **_child_kwargs(),
        )
    except Exception:
        return None, None
    lines = (out.stdout or "").strip().splitlines()
    raw = lines[0].strip() if lines else ""
    match = re.match(r"^(\d{4})\.(\d{2})\.(\d{2})", raw)
    if not match:
        return None, raw or None
    return int("".join(match.groups())), raw


def ytdlp_is_stale():
    number, _ = ytdlp_version()
    return number is not None and number < MIN_YTDLP


def ytdlp_warning():
    """One line naming the yt-dlp problem, or None when it is fine."""
    number, raw = ytdlp_version()
    if not tool_path("yt-dlp"):
        return "yt-dlp is missing: YouTube search and playback will not work"
    if number is not None and number < MIN_YTDLP:
        return ("yt-dlp %s is too old for YouTube: quit and run  crt-music --update-ytdlp"
                % raw)
    return None


def update_ytdlp():
    """Install the current standalone yt-dlp into our own bin directory.

    It goes there rather than over the packaged one: no root needed, nothing
    the package manager owns is touched, and the player puts that directory
    first on PATH, so the fresh build wins over a stale system copy.
    """
    asset = ytdlp_asset()
    url = "%s/%s" % (YTDLP_RELEASE, asset)
    target_dir = app_bin_dir()
    target = os.path.join(target_dir, "yt-dlp.exe" if IS_WINDOWS else "yt-dlp")
    print("Downloading %s" % url)
    try:
        os.makedirs(target_dir, exist_ok=True)
        request = urllib.request.Request(url, headers={"User-Agent": "FSpotify/%s" % VERSION})
        with urllib.request.urlopen(request, timeout=120) as response:
            data = response.read()
    except Exception as exc:
        print("could not download yt-dlp: %s" % exc)
        print("Download it yourself from https://github.com/yt-dlp/yt-dlp/releases")
        return 1
    if len(data) < 100000:
        print("the download looks truncated (%d bytes); try again" % len(data))
        return 1
    temp = target + ".new"
    try:
        with open(temp, "wb") as handle:
            handle.write(data)
        os.chmod(temp, 0o755)
        os.replace(temp, target)   # atomic: never leaves a half-written yt-dlp
    except OSError as exc:
        print("could not write %s: %s" % (target, exc))
        return 1
    print("Installed %s" % target)
    # _extend_path() skipped this directory if it did not exist when the
    # process started, so put it on PATH now to report the new version.
    if target_dir not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = target_dir + os.pathsep + os.environ.get("PATH", "")
    number, raw = ytdlp_version()
    if raw:
        print("yt-dlp is now %s" % raw)
    if number is not None and number < MIN_YTDLP:
        print("warning: that is still older than expected; check your network")
    return 0


def install_hint(tool):
    """One line telling the user how to install a missing helper here."""
    if IS_WINDOWS:
        package = "shinchiro.mpv" if tool == "mpv" else "yt-dlp.yt-dlp"
        return "  winget install " + package
    if IS_MACOS:
        return "  brew install " + tool
    for manager, command in (
        ("apt-get", "sudo apt install"),
        ("dnf", "sudo dnf install"),
        ("pacman", "sudo pacman -S"),
        ("zypper", "sudo zypper install"),
        ("apk", "doas apk add"),
        ("xbps-install", "sudo xbps-install -S"),
        ("emerge", "sudo emerge"),
        ("eopkg", "sudo eopkg install"),
    ):
        if shutil.which(manager):
            return "  %s %s" % (command, tool)
    return "  install %s with your package manager" % tool

