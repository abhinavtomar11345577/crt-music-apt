                    cur = -1
                    first = 0
                    safe_addstr(list_top, 2, "(unsynced lyrics: no timestamps available)", amber)
                start_row = 0 if synced else 1
                for row in range(start_row, list_height):
                    i = first + row - start_row
                    if not (0 <= i < len(lines)):
                        continue
                    text = trunc(lines[i], w - 4)
                    x0 = max(2, (w - len(text)) // 2)
                    attr = (amber | curses.A_REVERSE) if i == cur else green
                    safe_addstr(list_top + row, x0, text, attr)
                    if synced:
                        clickables.append(
                            (list_top + row, x0, x0 + len(text), (lambda s=synced[i][0]: seek_to(s)))
                        )
        else:
            if not queue:
                safe_addstr(
                    list_top,
                    2,
                    trunc("Queue is empty. Go to SEARCH (F2), pick a track, then 'n' (play next) or 'a' (add to queue).", w - 4),
                    green,
                )
            else:
                visible = queue[:list_height]
                for i, t in enumerate(visible):
                    y = list_top + i
                    marker = ">" if i == qsel and focus == "queue" else " "
                    tag = "NEXT" if i == 0 else f"{i + 1:>2}"
                    dur = fmt_time(t["duration"])
                    base = f"{marker} {tag}. {t['title']}  [{t['uploader']}] ({dur})"
                    remove_btn = "  [x]"
                    avail = w - 4
                    show_btn = avail > len(remove_btn) + 5
                    text_w = max(0, avail - len(remove_btn)) if show_btn else avail
                    text = trunc(base, text_w)
                    if show_btn:
                        text = text.ljust(text_w)
                    line = text + (remove_btn if show_btn else "")
                    attr = (green | curses.A_REVERSE) if (i == qsel and focus == "queue") else green
                    safe_addstr(y, 2, line, attr)
                    clickables.append((y, 2, 2 + len(text), (lambda idx=i: queue_play(idx))))
                    if show_btn:
                        b_x0 = 2 + len(text) + 2
                        clickables.append((y, b_x0, b_x0 + 3, (lambda idx=i: queue_remove(idx))))

        safe_addstr(panel_top, 2, "-" * max(0, w - 4), green)

        now_playing = trunc(current["title"], 40) if current else "(nothing loaded)"
        now_line = f"NOW: {now_playing}"
        if queue:
            nxt_title = trunc(queue[0]["title"], 22)
            extra = f"   NEXT: {nxt_title}"
            if len(queue) > 1:
                extra += f" (+{len(queue) - 1} more)"
            if len(now_line) + len(extra) <= w - 4:
                now_line += extra
        safe_addstr(panel_top + 1, 2, trunc(now_line, w - 4), amber)

        bar_w = max(10, w - 20)
        frac = 0.0
        if current and duration:
            frac = clamp((time_pos or 0) / duration, 0, 1)
        filled = int(bar_w * frac)
        bar = "#" * filled + "-" * (bar_w - filled)
        safe_addstr(panel_top + 2, 2, f"[{bar}] {fmt_time(time_pos)}/{fmt_time(duration)}", green)

        play_label = "[ PAUSE ]" if (current and not paused) else "[ PLAY ]"
        x = 2
        safe_addstr(panel_top + 3, x, play_label, green | curses.A_REVERSE)
        clickables.append((panel_top + 3, x, x + len(play_label), toggle_pause))
        x += len(play_label) + 2

        rew_label = "[ <<10s ]"
        safe_addstr(panel_top + 3, x, rew_label, green)
        clickables.append((panel_top + 3, x, x + len(rew_label), rewind))
        x += len(rew_label) + 2

        fwd_label = "[ 10s>> ]"
        safe_addstr(panel_top + 3, x, fwd_label, green)
        clickables.append((panel_top + 3, x, x + len(fwd_label), forward))

        x = 2
        speed_txt = f"SPEED {speed:.1f}x [-][+]"
        safe_addstr(panel_top + 4, x, speed_txt, green)
        minus_x = x + speed_txt.index("[-]")
        clickables.append((panel_top + 4, minus_x, minus_x + 3, lambda: adjust_speed(-SPEED_STEP)))
        plus_x = x + speed_txt.index("[+]")
        clickables.append((panel_top + 4, plus_x, plus_x + 3, lambda: adjust_speed(SPEED_STEP)))
        x += len(speed_txt) + 3

        bass_txt = f"BASS {bass:+d}dB [-][+]"
        safe_addstr(panel_top + 4, x, bass_txt, green)
        minus_x = x + bass_txt.index("[-]")
        clickables.append((panel_top + 4, minus_x, minus_x + 3, lambda: adjust_bass(-EQ_STEP)))
        plus_x = x + bass_txt.index("[+]")
        clickables.append((panel_top + 4, plus_x, plus_x + 3, lambda: adjust_bass(EQ_STEP)))
        x += len(bass_txt) + 3

        treble_txt = f"TREBLE {treble:+d}dB [-][+]"
        safe_addstr(panel_top + 4, x, treble_txt, green)
        minus_x = x + treble_txt.index("[-]")
        clickables.append((panel_top + 4, minus_x, minus_x + 3, lambda: adjust_treble(-EQ_STEP)))
        plus_x = x + treble_txt.index("[+]")
        clickables.append((panel_top + 4, plus_x, plus_x + 3, lambda: adjust_treble(EQ_STEP)))

        x = 2
        vol_txt = f"VOL {'MUTE' if muted else str(volume) + '%'} [-][+]"
        safe_addstr(panel_top + 5, x, vol_txt, green)
        minus_x = x + vol_txt.index("[-]")
        clickables.append((panel_top + 5, minus_x, minus_x + 3, lambda: adjust_volume(-VOL_STEP)))
        plus_x = x + vol_txt.index("[+]")
        clickables.append((panel_top + 5, plus_x, plus_x + 3, lambda: adjust_volume(VOL_STEP)))
        x += len(vol_txt) + 3

        mute_txt = "[ UNMUTE ]" if muted else "[ MUTE ]"
        safe_addstr(panel_top + 5, x, mute_txt, (amber | curses.A_REVERSE) if muted else green)
        clickables.append((panel_top + 5, x, x + len(mute_txt), toggle_mute))

        if view == "search":
            hint = "LIST: ENTER play now   n play next   a add to queue"
        elif view == "radio":
            hint = "RADIO: ENTER search/top stations   TAB list   local or local: city"
        elif view == "lyrics":
            hint = "LYRICS: click a line to jump there   (lyrics from lrclib.net)"
        elif view == "link":
            hint = "LINK: paste a YouTube URL, ENTER play now   Ctrl+U clear"
        else:
            hint = "QUEUE: ENTER play now   x remove   { } reorder   c clear all"
        safe_addstr(panel_top + 7, max(0, (w - len(hint)) // 2), trunc(hint, w), green)

        footer = "TAB focus  F2 next tab  F3 lyrics  F4 link  F5 radio  SPACE play/pause  ←/→ seek  9/0 vol  m mute  ESC quit"
        safe_addstr(h - 1, max(0, (w - len(footer)) // 2), trunc(footer, w), green)

        stdscr.refresh()
        time.sleep(TICK)

    mpv.quit()


USAGE = """crt-music - FSpotify, a terminal music and internet radio player

usage: crt-music [--version] [--check] [--update-ytdlp] [--help]

  --version        print the version and exit
  --check          report whether Python, curses, mpv and yt-dlp are usable
  --update-ytdlp   install the current yt-dlp for this user and exit
  --help           print this message

If YouTube tracks will not play, the cause is almost always a yt-dlp that is
too old for the way YouTube now serves streams. Fix it with:

    crt-music --update-ytdlp

Run it with no arguments to start the player. F5 opens the radio tab; the
footer lists the other keys. Set FSPOTIFY_RADIO_COUNTRY=IN (or another ISO
country code) to choose the country used by the radio's local search."""


def check_environment():
    """Report what is installed. The installers run this to verify a setup,
    so it must work without a terminal of its own and never start curses."""
    ok = True
    print("crt-music %s" % VERSION)
    print("python     %s (%s)" % (sys.version.split()[0], sys.executable))
    if curses is None:
        ok = False
        print("curses     MISSING")
        if IS_WINDOWS:
            print("           install it with: %s -m pip install windows-curses"
                  % os.path.basename(sys.executable))
    else:
        print("curses     ok")
    for tool in ("mpv", "yt-dlp"):
        found = tool_path(tool)
        print("%-10s %s" % (tool, found or "MISSING"))
        if not found:
            ok = False
            print("%s" % install_hint(tool))
    number, raw = ytdlp_version()
    if raw:
        state = "too old for YouTube" if (number is not None and number < MIN_YTDLP) else "ok"
        print("%-10s %s (%s)" % ("yt-dlp ver", raw, state))
        if state != "ok":
            ok = False
            print("           fix it with: crt-music --update-ytdlp")
    print("ready" if ok else "not ready")
    return 0 if ok else 1


def run():
    args = sys.argv[1:]
    if args:
        if args[0] in ("-V", "--version"):
            print("crt-music %s" % VERSION)
            return 0
        if args[0] in ("-h", "--help"):
            print(USAGE)
            return 0
        if args[0] == "--check":
            return check_environment()
        if args[0] in ("--update-ytdlp", "--update-yt-dlp"):
            return update_ytdlp()
        print("crt-music: unknown option: %s" % args[0], file=sys.stderr)
        print(USAGE, file=sys.stderr)
        return 2

    try:
        locale.setlocale(locale.LC_ALL, "")
    except (locale.Error, ValueError):
        pass  # the C locale still works, it just draws plainer

    if curses is None:
        print("crt-music needs the curses module.")
        if IS_WINDOWS:
            print("Install it with:\n  %s -m pip install windows-curses"
                  % os.path.basename(sys.executable))
        else:
            print("Your Python was built without curses; install a full python3.")
        return 1
    if not tool_path("mpv"):
        print("crt-music needs mpv for playback. Install it first:\n" + install_hint("mpv"))
        return 1
    if not tool_path("yt-dlp"):
        print("crt-music needs yt-dlp to search YouTube. Install it first:\n"
              + install_hint("yt-dlp"))
        return 1
    curses.wrapper(main)
    return 0


if __name__ == "__main__":
    sys.exit(run())
