def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def fmt_time(seconds):
    if seconds is None:
        return "--:--"
    seconds = int(seconds)
    m, s = divmod(seconds, 60)
    h, m = divmod(m, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def trunc(s, n):
    if n <= 0:
        return ""
    if len(s) <= n:
        return s
    return s[: max(0, n - 1)] + "…"


class MPV:
    """Talks to a headless mpv over its JSON IPC channel.

    That channel is a Unix domain socket on Linux and macOS and a named pipe
    on Windows, so the two are wrapped behind _send/_recv. Replies arrive on a
    reader thread and are handed to whoever is waiting for that request id;
    a pipe cannot be polled with a timeout the way a socket can, and one
    reader keeps both platforms on the same code path.
    """

    def __init__(self):
        if IS_WINDOWS:
            self.sock_path = r"\\.\pipe\crt-music-%d" % os.getpid()
        else:
            self.sock_path = os.path.join(tempfile.gettempdir(), f"crt-music-{os.getpid()}.sock")
        argv = [
            tool_path("mpv") or "mpv",
            "--no-video",
            "--idle=yes",
            "--keep-open=yes",
            "--no-terminal",
            "--ytdl-format=bestaudio/best",
            f"--input-ipc-server={self.sock_path}",
        ]
        # mpv resolves YouTube pages with its own copy of yt-dlp, found on
        # its PATH. Hand it the exact one the player checked instead: on
        # Debian and Ubuntu the packaged yt-dlp is years old and can no
        # longer extract a stream, so this is the difference between every
        # track playing and every track failing to load.
        ytdlp = tool_path("yt-dlp")
        if ytdlp:
            argv.append(f"--script-opts=ytdl_hook-ytdl_path={ytdlp}")
        self.proc = subprocess.Popen(
            argv,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            **_child_kwargs(),
        )
        self._conn = None
        self._lock = threading.Lock()
        self._req_id = itertools.count(1)
        self._cv = threading.Condition()
        self._pending = set()
        self._responses = {}
        self._closed = False
        self._connect()
        self._reader = threading.Thread(target=self._read_loop, daemon=True)
        self._reader.start()

    def _connect(self):
        for _ in range(50):
            try:
                if IS_WINDOWS:
                    # mpv creates the pipe; opening it is the connect step,
                    # and it simply fails until mpv is ready.
                    self._conn = open(self.sock_path, "r+b", buffering=0)
                    return
                if os.path.exists(self.sock_path):
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(self.sock_path)
                    self._conn = s
                    return
            except OSError:
                pass
            time.sleep(0.1)
        raise RuntimeError("could not connect to mpv's IPC socket")

    def _send(self, data):
        if IS_WINDOWS:
            self._conn.write(data)
            self._conn.flush()
        else:
            self._conn.sendall(data)

    def _recv(self):
        # One read call each time: both an unbuffered pipe and a socket return
        # whatever has arrived rather than waiting for the full 4096 bytes.
        if IS_WINDOWS:
            return self._conn.read(4096)
        return self._conn.recv(4096)

    def _read_loop(self):
        buf = b""
        while True:
            try:
                chunk = self._recv()
            except Exception:
                chunk = b""
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line.strip():
                    continue
                try:
                    msg = json.loads(line)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue
                rid = msg.get("request_id")
                if rid is None:
                    continue  # an event, not a reply to one of our commands
                with self._cv:
                    # Only keep replies somebody is still waiting for, so a
                    # timed-out request cannot grow this dict forever.
                    if rid in self._pending:
                        self._responses[rid] = msg
                        self._cv.notify_all()
        with self._cv:
            self._closed = True
            self._cv.notify_all()

    def command(self, *args, timeout=2.0):
        rid = next(self._req_id)
        with self._cv:
            self._pending.add(rid)
        try:
            with self._lock:
                payload = json.dumps({"command": list(args), "request_id": rid}) + "\n"
                try:
                    self._send(payload.encode())
                except (OSError, ValueError):
                    return None
            deadline = time.time() + timeout
            with self._cv:
                while rid not in self._responses:
                    remaining = deadline - time.time()
                    if remaining <= 0 or self._closed:
                        return None
                    self._cv.wait(remaining)
                return self._responses.pop(rid)
        finally:
            with self._cv:
                self._pending.discard(rid)
                self._responses.pop(rid, None)

    def set_property(self, name, value):
        return self.command("set_property", name, value)

    def get_property(self, name):
        resp = self.command("get_property", name)
        if resp and resp.get("error") == "success":
            return resp.get("data")
        return None

    def loadfile(self, url):
        return self.command("loadfile", url, "replace")

    def set_pause(self, paused):
        return self.set_property("pause", paused)

    def seek_relative(self, seconds):
        return self.command("seek", seconds, "relative")

    def seek_absolute(self, seconds):
        return self.command("seek", seconds, "absolute")

    def set_speed(self, speed):
        return self.set_property("speed", round(speed, 2))

    def set_eq(self, bass_db, treble_db):
        filt = f"lavfi=[bass=g={bass_db}:f=110:w=0.6,treble=g={treble_db}:f=3000:w=0.6]"
        return self.set_property("af", filt)

    def set_volume(self, vol):
        # Per-player volume (mpv's own softvol), independent of the system/global mixer.
        return self.set_property("volume", vol)

    def quit(self):
        try:
            self.command("quit")
        except Exception:
            pass
        try:
            self.proc.terminate()
        except Exception:
            pass
        try:
            self._conn.close()
        except Exception:
            pass
        if not IS_WINDOWS:
            # A named pipe disappears with the process that created it; a
            # Unix socket file does not.
            try:
                os.remove(self.sock_path)
            except OSError:
                pass


BIG_FONT = {
    "F": ["#####", "#....", "####.", "#....", "#...."],
    "S": [".####", "#....", ".###.", "....#", "####."],
    "P": ["####.", "#...#", "####.", "#....", "#...."],
    "O": [".###.", "#...#", "#...#", "#...#", ".###."],
    "T": ["#####", "..#..", "..#..", "..#..", "..#.."],
    "I": ["#####", "..#..", "..#..", "..#..", "#####"],
    "Y": ["#...#", ".#.#.", "..#..", "..#..", "..#.."],
    "-": [".....", ".....", "#####", ".....", "....."],
}


def show_splash(stdscr, green, amber, hold_seconds=2.8):
    """Big 'F--- SPOTIFY' wordmark + tagline, shown once before the player UI."""
    stdscr.erase()
    h, w = stdscr.getmaxyx()

    word = "F--- SPOTIFY"
    letter_w, gap = 5, 1
    total_w = len(word) * letter_w + (len(word) - 1) * gap
    start_x = max(0, (w - total_w) // 2)
    start_y = max(0, (h - 5) // 2 - 2)

    for i, letter in enumerate(word):
        pattern = BIG_FONT.get(letter)
        if not pattern:
            continue
        lx = start_x + i * (letter_w + gap)
        for ry, row in enumerate(pattern):
            y = start_y + ry
            if y < 0 or y >= h:
                continue
            for rx, ch in enumerate(row):
                if ch != "#":
                    continue
                x = lx + rx
                if 0 <= x < w:
                    try:
                        stdscr.addstr(y, x, "█", amber)
                    except curses.error:
                        pass

    tagline = "free music for all"
    tag_y = start_y + 5 + 2
    if 0 <= tag_y < h:
        try:
            stdscr.addstr(tag_y, max(0, (w - len(tagline)) // 2), tagline, green)
        except curses.error:
            pass

    stdscr.refresh()
    stdscr.nodelay(True)
    deadline = time.time() + hold_seconds
    while time.time() < deadline:
        try:
            key = stdscr.getch()
        except curses.error:
            key = -1
        if key != -1:
            break
        time.sleep(0.03)


def search_youtube(query, n=12):
    try:
        out = subprocess.run(
            [
                tool_path("yt-dlp") or "yt-dlp",
                "--flat-playlist",
                "-j",
                "--no-warnings",
                f"ytsearch{n}:{query}",
            ],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=30,
            **_child_kwargs(),
        )
    except Exception as e:
        return [], str(e)
    if out.returncode != 0:
        message = (out.stderr.strip().splitlines() or ["search failed"])[-1]
        if ytdlp_is_stale():
            message += "  (yt-dlp is out of date: run crt-music --update-ytdlp)"
        return [], message
    results = []
    for line in out.stdout.strip().splitlines():
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not d.get("id"):
            continue
        results.append(
            {
                "id": d["id"],
                "title": d.get("title") or "(untitled)",
                "uploader": d.get("uploader") or d.get("channel") or "",
                "duration": d.get("duration"),
            }
        )
    return results, None


def resolve_link(url):
    """Looks up a single YouTube URL (watch, youtu.be, shorts, music...) as a track dict."""
    try:
        out = subprocess.run(
            [
                tool_path("yt-dlp") or "yt-dlp",
                "-j",
                "--no-warnings",
                "--skip-download",
                "--playlist-items",
                "1",
                url,
            ],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=30,
            **_child_kwargs(),
        )
    except Exception as e:
        return None, str(e)
    if out.returncode != 0:
        message = (out.stderr.strip().splitlines() or ["could not open link"])[-1]
        if ytdlp_is_stale():
            message += "  (yt-dlp is out of date: run crt-music --update-ytdlp)"
        return None, message
    for line in out.stdout.strip().splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if d.get("id"):
            return {
                "id": d["id"],
                "title": d.get("title") or "(untitled)",
                "uploader": d.get("uploader") or d.get("channel") or "",
                "duration": d.get("duration"),
            }, None
    return None, "no video found at that link"


def radio_request(path, params=None):
    """Fetch data from Radio Browser, trying another public mirror on failure."""
    query = urllib.parse.urlencode(params or {})
    suffix = f"?{query}" if query else ""
    last_error = "radio directory unavailable"
    for server in RADIO_API_SERVERS:
        url = f"{server}{path}{suffix}"
        req = urllib.request.Request(url, headers={"User-Agent": "FSpotify/1.0"})
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.load(resp), None
        except Exception as e:
            last_error = str(e)
    return None, last_error


def current_locale_name():
    """The system locale, e.g. "en_IN".

    Windows sets none of the LC_* variables, and locale.getdefaultlocale()
    is deprecated and goes away in Python 3.15, so ask getlocale() first.
    """
    try:
        name = locale.getlocale()[0]
        if name:
            return name
        name = locale.setlocale(locale.LC_CTYPE, "")
        if name and name not in ("C", "POSIX"):
            return name
    except (locale.Error, ValueError):
        pass
    return ""


def local_country_code():
    configured = os.environ.get("FSPOTIFY_RADIO_COUNTRY", "").strip()
    if configured:
        return configured.upper()[:2]
    languages = [
        os.environ.get("LC_ALL", ""),
        os.environ.get("LC_MESSAGES", ""),
        os.environ.get("LANG", ""),
        current_locale_name(),
    ]
    for language in languages:
        match = re.search(r"[_-]([A-Za-z]{2})(?:\.|$)", language)
        if match:
            return match.group(1).upper()
    return ""


def station_to_track(station):
    stream_url = station.get("url_resolved") or station.get("url")
    station_uuid = station.get("stationuuid")
    if not stream_url or not station_uuid:
        return None
    parsed = urllib.parse.urlparse(stream_url)
    if parsed.scheme not in ("http", "https"):
        return None
    location = " · ".join(
        part for part in (station.get("country"), station.get("state")) if part
    )
    details = " · ".join(
        part for part in (location, station.get("codec"), str(station.get("bitrate") or "") + " kbps") if part and part != " kbps"
    )
    return {
        "id": station_uuid,
        "kind": "radio",
        "title": station.get("name") or "(unnamed station)",
        "uploader": details,
        "duration": None,
        "stream_url": stream_url,
        "stationuuid": station_uuid,
    }


def preset_radio_tracks(query):
    normalized = re.sub(r"[^a-z0-9]+", "", query.lower())
    if "redfm" not in normalized and "935" not in normalized and normalized != "red":
        return []
    return [
        {
            "id": "preset-red-fm-network",
            "kind": "radio",
            "title": "Red FM India (network fallback)",
            "uploader": "India · AAC · 320 kbps",
            "duration": None,
            "stream_url": RED_FM_NETWORK_STREAM,
            "stationuuid": "preset-red-fm-network",
        },
    ]


def search_radio(query, n=RADIO_LIMIT):
    """Search the open Radio Browser directory, including country/local searches."""
    text = query.strip()
    preset_tracks = preset_radio_tracks(text)
    params = {
        "limit": n,
        "hidebroken": "true",
        "order": "clickcount",
        "reverse": "true",
    }
    if text.lower().startswith("local"):
        location = re.sub(r"^local\s*:?[ ]*", "", text, flags=re.I).strip()
        country_code = local_country_code()
        if country_code:
            params["countrycode"] = country_code
        if location:
            params["name"] = location
        data, error = radio_request("/json/stations/search", params)
        if not data and location:
            params.pop("name", None)
            params["state"] = location
            data, error = radio_request("/json/stations/search", params)
    elif text:
        params["name"] = text
        data, error = radio_request("/json/stations/search", params)
        if not data:
            params.pop("name", None)
            params["country"] = text
            data, error = radio_request("/json/stations/search", params)
        if not data:
            params.pop("country", None)
            params["tag"] = text
            data, error = radio_request("/json/stations/search", params)
    else:
        data, error = radio_request(f"/json/stations/topclick/{n}", {"hidebroken": "true"})

    if error and preset_tracks:
        return preset_tracks, None
    if error:
        return [], error
    tracks = []
    seen = set()
    for track in preset_tracks:
        seen.add(track["id"])
        tracks.append(track)
    for station in data or []:
        track = station_to_track(station)
        if track and track["id"] not in seen:
            seen.add(track["id"])
            tracks.append(track)
    return tracks, None


LRCLIB = "https://lrclib.net/api/search"
# "(Official Video)", "[Lyrics]", "(HD Remaster)" and similar YouTube title noise.
TITLE_NOISE = re.compile(
    r"\s*[\(\[][^\)\]]*\b(official|lyrics?|video|audio|visuali[sz]er|hd|hq|4k|remaster(ed)?|m/?v)\b[^\)\]]*[\)\]]",
    re.I,
)
LRC_STAMP = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def guess_artist_title(track):
    """Best-effort split of a YouTube title into (artist, song)."""
    title = TITLE_NOISE.sub("", track["title"])
    title = re.sub(r"\s*\|.*$", "", title).strip()
    for sep in (" - ", " – ", " — "):
        if sep in title:
            artist, song = title.split(sep, 1)
            return artist.strip(), song.strip()
    artist = re.sub(r"\s*(- Topic|VEVO)$", "", track.get("uploader") or "").strip()
    return artist, title


def parse_lrc(text):
    lines = []
    for raw in text.splitlines():
        stamps = LRC_STAMP.findall(raw)
        if not stamps:
            continue
        words = LRC_STAMP.sub("", raw).strip()
        for m, s in stamps:
            lines.append((int(m) * 60 + float(s), words))
    lines.sort(key=lambda l: l[0])
    return lines


def lrclib_search(params):
    url = f"{LRCLIB}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": "crt-music (FSpotify)"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


def fetch_lyrics(track):
    """Returns {"synced": [(t, line)...]} or {"plain": [line...]} or {"error": msg}."""
    artist, song = guess_artist_title(track)
    attempts = []
    if artist and song:
        attempts.append({"track_name": song, "artist_name": artist})
    attempts.append({"q": f"{artist} {song}".strip()})
    dur = track.get("duration")
    plain = None
    try:
        for params in attempts:
            hits = lrclib_search(params)
            synced = [x for x in hits if x.get("syncedLyrics")]
            if synced:
                if dur:
                    synced.sort(key=lambda x: abs((x.get("duration") or 0) - dur))
                return {"synced": parse_lrc(synced[0]["syncedLyrics"])}
            if plain is None:
                plain = next((x["plainLyrics"] for x in hits if x.get("plainLyrics")), None)
    except Exception as e:
        return {"error": f"lyrics lookup failed: {e}"}
    if plain:
        return {"plain": plain.splitlines()}
    return {"error": f"No lyrics found for {artist} - {song}"}


